{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_healthCheck",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/minutas/contratos/{id}": {
      "get": {
        "operationId": "MinutaController_obtenerMinuta",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id del contrato general (entero positivo)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Siempre HTTP 200. El resultado va en Status del cuerpo (200, 400, 404, 422, 502 o 500) y Data solo trae el PDF cuando Status es 200.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaMinutaDto"
                }
              }
            }
          }
        },
        "summary": "Generación de minuta en PDF (base64)",
        "tags": [
          "Minuta"
        ]
      }
    },
    "/acta-poliza/contratos/{id}": {
      "get": {
        "operationId": "ActaPolizaController_obtenerActaPoliza",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id del contrato general",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitud procesada correctamente"
          },
          "400": {
            "description": "Póliza inconsistente"
          },
          "404": {
            "description": "Recurso no encontrado"
          },
          "500": {
            "description": "Error interno del servidor"
          },
          "502": {
            "description": "Servicio dependiente no disponible"
          }
        },
        "summary": "Generación del acta de aprobación de póliza en PDF (base64)",
        "tags": [
          "ActaPoliza"
        ]
      }
    },
    "/acta-poliza/contratos/{id}/borrador": {
      "post": {
        "operationId": "ActaPolizaController_obtenerBorradorActaPoliza",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id del contrato general",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "amparos": [
                    {
                      "id": 1,
                      "valor": 5000000,
                      "fecha_inicio": "2024-01-15",
                      "fecha_fin": "2025-01-15"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Borrador generado correctamente"
          },
          "400": {
            "description": "Póliza inconsistente"
          },
          "404": {
            "description": "Recurso no encontrado"
          },
          "502": {
            "description": "Servicio dependiente no disponible"
          }
        },
        "summary": "Borrador del acta de aprobación de póliza en PDF (base64), con amparos aún sin registrar",
        "tags": [
          "ActaPoliza"
        ]
      }
    }
  },
  "info": {
    "title": "Minuta Contractual MID",
    "description": "API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "API",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "RespuestaMinutaDto": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean",
            "example": true,
            "description": "true solo cuando Status es 200"
          },
          "Status": {
            "type": "number",
            "example": 200,
            "enum": [
              200,
              400,
              404,
              422,
              500,
              502
            ],
            "description": "Resultado: 200 minuta generada; 400 id inválido; 404 contrato o plantilla no encontrados; 422 faltan datos obligatorios; 502 servicio no disponible; 500 error inesperado"
          },
          "Message": {
            "type": "string",
            "example": "Minuta generada exitosamente",
            "description": "Mensaje del resultado. En 422: \"Faltan datos: <lista>\"; en 502: \"Servicio no disponible: <servicio>\""
          },
          "Data": {
            "type": "string",
            "example": "JVBERi0xLjcK...",
            "description": "PDF de la minuta en base64; solo viene con Status 200"
          }
        },
        "required": [
          "Success",
          "Status",
          "Message"
        ]
      }
    }
  }
}